# ---- environment ----
APP_ENV=development              # development | production | test
DEBUG=false
LOG_LEVEL=INFO

# ---- database ----
# SQLite for local development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://companion:secret@localhost:5432/companion
DATABASE_URL=sqlite:///./data/app.db
AUTO_MIGRATE=true                # dev: apply Alembic migrations on startup (default off in production)
DATA_DIR=./data                  # generated audio, voice references, previews

# ---- auth ----
# Required in production, at least 32 chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SESSION_TTL=604800               # seconds (7 days)
COOKIE_SECURE=false              # defaults to true when APP_ENV=production
TRUSTED_HOSTS=                   # e.g. companion.example.com (comma-separated); empty = any

# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=      # comma-separated, tried in order when the primary fails
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
CONTEXT_MAX_TOKENS=6000          # prompt budget: persona + memories + summary + recent messages
CONTEXT_RECENT_MESSAGES=20
SUMMARY_TRIGGER_MESSAGES=30      # summarize older history once this many messages are unsummarized

# ---- voice ----
VOICE_ENGINE=xtts                # xtts (local GPU) | f5tts (local GPU) | inworld (cloud API)
INWORLD_API_KEY=
STT_MODEL=base                   # faster-whisper model size
STT_DEVICE=cpu                   # cpu | cuda
STT_COMPUTE_TYPE=int8
STT_TIMEOUT_SECONDS=120
STT_MAX_CONCURRENCY=2

# ---- limits ----
MAX_UPLOAD_MB=10
MAX_AUDIO_SECONDS=120
MIN_CLONE_AUDIO_SECONDS=3
MAX_MESSAGE_CHARS=4000
# "<count>/<second|minute|hour|day>" or "off"
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/hour
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_STT=20/minute
RATE_LIMIT_TTS=30/minute
RATE_LIMIT_VOICE_CLONE=5/hour
RATE_LIMIT_EXPORT=5/hour
REDIS_URL=                       # optional: shared rate-limit counters across processes

# ---- background jobs ----
WORKER_MODE=embedded             # embedded (in the web process) | external (python -m jobs.worker) | off
WORKER_POLL_SECONDS=1.0
JOB_TIMEOUT_SECONDS=600
